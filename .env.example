# Neon Postgres connection — yeni bir Neon projesi oluştur, sonra
# Project Dashboard → Connection Details → "Connection string" değerlerini buraya kopyala.
#
# DATABASE_URL: app runtime'da kullanılır (transaction pooler, ?sslmode=require)
# DIRECT_URL:   prisma migrate için (pooler bypass, direct connection)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# Paylaşılan şifre — istediğin metin (örn "treu2026"). Tüm cihazlarda aynısı girilir.
# Boş bırakırsan API'ler herkese açık olur (sadece geliştirme için).
APP_PASSWORD="treu-degistir-beni"
